# Runs the Golf Pick 'Em live leaderboard sync twice a day during play — noon
# and 4 PM CT, Thu–Sun. Updates positions + projected earnings and (majors)
# live-refreshes the cut/DQ penalty side pot. The third daily read, 8 PM CT
# with the withdrawal check, is golf-live-wd.timer.
#
# WHY NOT MORE OFTEN: Golf runs SlashGolf on the FREE RapidAPI tier (250
# calls/month) and nothing in `flask golf sync-run` enforces that budget —
# this cadence IS the budget gate. Three reads a day mirrors what the retired
# PythonAnywhere app ran for the whole 2026 season (~115 calls/month across
# every golf timer); the original every-30-min rule was ~600/month. Off-week
# firings are free: get_active_tournaments() returns nothing, no API call.
# Locked by tests/test_golf_timers.py.
[Unit]
Description=Run Golf Pick 'Em live leaderboard sync (Thu–Sun, noon + 4 PM CT)

[Timer]
# Timezone is INLINE in OnCalendar — no TimeZone= directive exists for timers.
# Validate on the droplet: systemd-analyze calendar 'Thu..Sun *-*-* 12,16:00:00 America/Chicago'
OnCalendar=Thu..Sun *-*-* 12,16:00:00 America/Chicago
Persistent=true

[Install]
WantedBy=timers.target
