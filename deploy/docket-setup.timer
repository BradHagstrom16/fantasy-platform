# Runs The Docket's week setup Tuesday 06:15 CT.
#
# 06:15, not 06:00: docket weeks partition time at Tuesday 06:00 America/
# Chicago boundaries (games/docket/services/weeks.py), and the mode resolves
# its week from the clock. Firing at the boundary instant itself would race
# the arithmetic that decides which week it is creating.
#
# This timer was held back until the first write to empty production tables
# had been a deliberate act; that write happened with the 2026-08-19 preview
# Week-1 import, so it now runs alongside the other docket timers. Out of
# season it exits 0 under --scheduled; against an existing week it only
# gap-fills (locked lines are never overwritten), so the real Tue Sep 1
# Week-1 numbers still ride on the hand-run wipe-then-import in
# games/docket/cli.py's runbook.
[Unit]
Description=Run The Docket week setup Tuesday 06:15 CT

[Timer]
# Timezone is INLINE in OnCalendar — no TimeZone= directive exists.
OnCalendar=Tue *-*-* 06:15:00 America/Chicago
Persistent=true

[Install]
WantedBy=timers.target
