# Runs CFB week setup Monday mornings (CT) — games for the upcoming
# Thu-Wed week are in the Odds API well before then.
#
# 09:00, not 06:00 (amended 2026-09-07): run_setup activates the new week
# and deactivates the old one with no completeness guard, and every room
# surface reads is_active. cfb-scores.timer fires Monday 08:00 CT, so setup
# waits for it — in an ordinary week (last game Sunday) the old week is
# graded and complete before the room flips. A week with a Monday-night
# game still flips first; the room handles that by revealing the latest
# locked week on standings rather than by holding setup back (a held setup
# would slip the next week's spreads and picks-open by days in November,
# when Wednesday MAC games close a week).
[Unit]
Description=Run CFB Survivor week setup Monday 09:00 CT

[Timer]
# Timezone is specified INLINE in OnCalendar (systemd v240+); there is no
# separate TimeZone= directive for timer units.
OnCalendar=Mon *-*-* 09:00:00 America/Chicago
Persistent=true

[Install]
WantedBy=timers.target
