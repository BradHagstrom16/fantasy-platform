# World Cup advancement check — detect when group/knockout advancement is due
# and email the admin (once per pending-state episode). Never writes scoring state.
# Fired hourly by worldcup-advancement.timer. See worldcup-sync.service for install steps.

[Unit]
Description=World Cup advancement check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask worldcup sync --mode advancement
