# Golf Pick 'Em schedule sync — link seeded rows to real SlashGolf ids + refresh
# purses/formats. Fired Mondays by golf-schedule.timer.
#
# Install (all golf-* units together):
#   sudo cp /home/deploy/fantasy-platform/deploy/golf-*.service /etc/systemd/system/
#   sudo cp /home/deploy/fantasy-platform/deploy/golf-*.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now golf-schedule.timer golf-field.timer \
#        golf-live.timer golf-results.timer golf-remind.timer
# Validate each OnCalendar first, e.g.:
#   systemd-analyze calendar 'Thu..Sun *-*-* 06..23:0/30:00 America/Chicago'

[Unit]
Description=Golf Pick 'Em schedule sync (link ids, refresh purses)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask golf sync-run --mode schedule
