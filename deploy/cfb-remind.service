# CFB Survivor pick reminders — emails users who haven't picked.
# Fired hourly by cfb-remind.timer; the two windows (day-before T-26h35m to
# T-24h25m, final T-2h35m to T-25m) are resolved from the active week's
# deadline at runtime. Each spans two hourly firings; CfbWeek.last_reminder_type
# de-dups so a window mails at most once and the second firing is only an
# outage retry.

[Unit]
Description=CFB Survivor pick reminders (day-before T-26h35m..24h25m, final T-2h35m..25m, de-duped)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
# Club Desk steps 7-8 (ADR-065, docs/designs/unified-email.md): this firing
# IS the reminder desk. --anchor cfb: the desk leads Survivor's tiers only.
# --ride F,S: the Docket rides Friday's warning (pre-marking its 48h tier)
# and Saturday's final (pre-marking 24h) as a footnote, so docket-remind
# (After= this unit) skips both; the Docket's Sunday 2h tier stays its own.
# Rollout state lives on this line, never in .env. Rollback is this one
# line: `--ride F` undoes step 8; `flask cfb sync --mode remind` undoes the
# desk (the legacy pass stays in the CLI until step 9). Unlike that pass,
# the desk exits 1 when an active tier reached nobody, so a mail outage
# shows as a failed unit.
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask club desk --scheduled --anchor cfb --ride F,S
