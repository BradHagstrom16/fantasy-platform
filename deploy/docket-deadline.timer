# Runs The Docket's deadline pass Sunday 12:02 + 12:32 CT, after the
# 12:00 PM CT submission deadline.
#
# !! 12:02, never 12:00:00. run_deadline_pass refuses while now < deadline_at
#    (games/docket/services/deadline_pass.py), so a firing at the deadline
#    instant races its own precondition and fails.
#
# Running LATE is free, which is why the retry is a plain second firing rather
# than anything cleverer: the freeze is only-if-null, and the autopick pool is
# `kickoff_at_deadline >= deadline_at` — a pure function of data that stopped
# moving at 12:00. Persistent=true therefore makes a firing missed to a reboot
# correct rather than merely late.
[Unit]
Description=Run The Docket deadline pass Sun 12:02 + 12:32 CT

[Timer]
# Timezone is INLINE in OnCalendar — no TimeZone= directive exists.
OnCalendar=Sun *-*-* 12:02:00 America/Chicago
OnCalendar=Sun *-*-* 12:32:00 America/Chicago
Persistent=true

[Install]
WantedBy=timers.target
