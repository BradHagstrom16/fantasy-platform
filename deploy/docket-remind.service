# The Docket deadline reminders (D24) — three tiers before the Sunday
# 12:00 PM CT close (48h Friday, 24h Saturday, 2h Sunday), to unfinished
# sheets only. Costs no API credits.
#
# Exits non-zero only when a due tier reached NOBODY, which means mail is down
# with a deadline approaching. "No tier is due" and "this tier already went
# out" are the ordinary outcomes of an hourly run and exit 0.

[Unit]
Description=The Docket deadline reminders (de-duped, unfinished sheets only)
After=network-online.target
Wants=network-online.target
# Ordering only (no Wants=): since Club Desk step 7 the Survivor desk in
# cfb-remind pre-marks a Docket tier it carried as a rider. Both timers fire
# on the hour, and a Persistent boot replay queues them together; this edge
# lands the desk's mark before this pass reads last_reminder_tier, so a
# tier the rider covered is never sent twice. There is deliberately no lock
# in code.
After=cfb-remind.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask docket sync --mode remind --scheduled
