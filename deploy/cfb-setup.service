# CFB Survivor weekly setup — create next week, import games. Never
# activates: a week opens on the spreads run that lands its first line
# (ADR-062, cfb-spreads.service). Fired Mondays by cfb-setup.timer. Retries
# orphaned 0-game weeks automatically.
#
# Install (all 5 CFB pairs at once):
#   sudo cp /home/deploy/fantasy-platform/deploy/cfb-*.service /etc/systemd/system/
#   sudo cp /home/deploy/fantasy-platform/deploy/cfb-*.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cfb-setup.timer cfb-spreads.timer \
#       cfb-autopick.timer cfb-scores.timer cfb-remind.timer
#
# !! Do NOT enable before launch prep: SEASON_SCHEDULE['week_1_start'] in
#    games/cfb/constants.py must be updated to the 2026 season first, or
#    every computed week date/deadline is a year off (audit §9).
# Verify a timer's schedule before enabling:
#   systemd-analyze calendar "Mon *-*-* 06:00:00 America/Chicago"

[Unit]
Description=CFB Survivor weekly setup (create week, import games)
After=network-online.target
Wants=network-online.target
# Ordering only (no Wants=): when both Persistent timers catch up after
# downtime that spanned Monday 08:00 and 09:00 CT, the old week's scores
# run finishes before setup writes the next week. Setup no longer flips
# is_active (ADR-062), so this is about log order and the orphan-retry
# query reading a settled state, not the room. On an ordinary Monday the
# two never overlap and this line is inert; a Wants= would fire a second
# /scores call (2 credits) every setup.
After=cfb-scores.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask cfb sync --mode setup
