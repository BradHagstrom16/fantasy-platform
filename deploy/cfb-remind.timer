# Runs CFB pick reminders Fri + Sat 10:00 CT — inside the ±35-minute
# tolerance of the T-25h and T-1h windows for the Sat 11:00 CT deadline.
# !! Never schedule this more often than once per ~70-minute window: there
#    is no per-window sent-flag, so a faster cadence double-sends (audit §6).
[Unit]
Description=Run CFB Survivor pick reminders Fri/Sat 10:00 CT

[Timer]
# Timezone is INLINE in OnCalendar — no TimeZone= directive exists.
OnCalendar=Fri,Sat *-*-* 10:00:00 America/Chicago
Persistent=true

[Install]
WantedBy=timers.target
