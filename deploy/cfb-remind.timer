# Runs CFB Survivor pick reminders hourly, on the hour, CT.
#
# Hourly is SAFE because CfbWeek.last_reminder_type de-dups: a firing whose
# active window was already mailed does nothing, so the guarantee lives in
# the flag, not in this schedule (same shape as docket-remind.timer, D24).
# The cadence only has to land inside each window's ±35-minute tolerance at
# least once — which hourly does for ANY deadline time, including manually
# scheduled CFP weeks. Off-window firings are cheap no-ops.
[Unit]
Description=Run CFB Survivor pick reminders (hourly, de-duped)

[Timer]
# Timezone is INLINE in OnCalendar — no TimeZone= directive exists.
OnCalendar=*-*-* *:00:00 America/Chicago
Persistent=true

[Install]
WantedBy=timers.target
