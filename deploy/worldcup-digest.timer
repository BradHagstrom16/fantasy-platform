# Runs the World Cup daily results digest once a day (22:30 America/Chicago, pinned below).
[Unit]
Description=Send World Cup daily results digest

[Timer]
OnCalendar=*-*-* 22:30:00
# Pin to CT so the firing time matches run_digest's WORLDCUP_TZ "today" window
# regardless of the server clock.
TimeZone=America/Chicago
Persistent=true

[Install]
WantedBy=timers.target
