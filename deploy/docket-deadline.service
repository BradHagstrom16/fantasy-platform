# The Docket deadline pass — freeze every game's kickoff_at_deadline (the D7
# slot-substitution ordering input) and deal the D5 autopick package to every
# enrolled player. Nothing downstream can grade a week until this has run.
#
# Costs no API credits. Idempotent: the freeze is only-if-null and a completed
# sheet passes through autopick unchanged, so the 12:32 retry is free.
#
# Exits non-zero when the week has no sound tiebreaker designation. That is
# the alert that matters: kickoffs still froze, but autopick was skipped and
# needs `flask docket set-tiebreaker` plus a re-run.

[Unit]
Description=The Docket deadline pass (freeze kickoffs, deal autopicks)
# A failure mails the admin inbox and pings healthchecks.io; every success
# pings it too, the dead-man half (utils/job_alert.py, tests/test_job_alerts.py).
OnFailure=job-alert@%N.service
OnSuccess=job-ping@%N.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask docket sync --mode deadline --scheduled
