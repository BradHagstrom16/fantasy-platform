# Golf Pick 'Em live leaderboard sync — projected earnings + live major penalty
# refresh for active tournaments. Fired twice a day Thu–Sun (noon + 4 PM CT)
# by golf-live.timer; the 8 PM read with the withdrawal check is
# golf-live-wd.service. One leaderboard call per firing (free-tier budget).

[Unit]
Description=Golf Pick 'Em live leaderboard sync (projected earnings)
# A failure mails the admin inbox and pings healthchecks.io; every success
# pings it too, the dead-man half (utils/job_alert.py, tests/test_job_alerts.py).
OnFailure=job-alert@%N.service
OnSuccess=job-ping@%N.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
# Bound the run well under the next firing so a stuck sync can't pile up.
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask golf sync-run --mode live
