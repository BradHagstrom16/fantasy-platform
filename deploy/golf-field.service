# Golf Pick 'Em field sync — import the tournament field + tee times, set the
# pick deadline, send "Picks Are Open" / admin field alerts. Fired Tue/Wed
# AM+PM by golf-field.timer. The Wed evening pass is the one that admin-alerts
# on a still-short field (the run derives is_wednesday_evening from the clock).

[Unit]
Description=Golf Pick 'Em field sync (field, tee times, picks-open email)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask golf sync-run --mode field
