# Golf Pick 'Em deadline reminders — email enrolled players who haven't picked
# yet at the 24h / 12h / 1h windows. Fired hourly by golf-remind.timer. The
# `sync-run --mode remind` entrypoint short-circuits before the API client is
# built, so it needs no SLASHGOLF_API_KEY; de-dup via last_reminder_type prevents
# resending a tier even at hourly cadence.

[Unit]
Description=Golf Pick 'Em deadline reminders (24h/12h/1h, de-duped)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask golf sync-run --mode remind
