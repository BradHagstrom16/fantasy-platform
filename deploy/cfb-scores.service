# CFB Survivor score sync — fetch finals, grade picks, process weeks, then
# retry the open. Fired by cfb-scores.timer: Sun–Thu 08:00 CT in the regular
# season (a Mon/Tue/Wed game must be scored inside daysFrom=3), plus DAILY
# Dec 15 – Jan 25 — bowls and CFP games fall on any weekday. Weeks stuck
# incomplete >2 days past their last kickoff escalate in the admin email.
# The run ends with the open retry (ADR-062): a week with games that has not
# opened yet — Tuesday's Paper (club-paper.service) failed to open it, or an
# admin flipped the old week back — gets the opener now instead of waiting
# for Friday.

[Unit]
Description=CFB Survivor score sync (grade picks, process weeks, retry the open)
After=network-online.target
Wants=network-online.target
# Ordering only (no Wants=): the open retry above runs the same opener the
# Paper and the Friday spreads unit run. Hours apart on an ordinary day; a
# Persistent boot replay after downtime spanning 06:00 and 08:00 CT fires
# them all at once, and these lines keep the openers ahead of the retry so
# the opener never runs twice (two odds calls, two letters). A Wants= would
# fire an opener on every scores run.
After=cfb-spreads.service
After=club-paper.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask cfb sync --mode scores
