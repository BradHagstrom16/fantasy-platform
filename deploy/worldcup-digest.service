# World Cup daily results digest — email the admin a summary of matches
# finalized today (CT). Fired once daily by worldcup-digest.timer.
# The "today" window is computed in WORLDCUP_TZ inside the command, so the
# digest content is correct regardless of the server's clock.

[Unit]
Description=World Cup daily results digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask worldcup sync --mode digest
