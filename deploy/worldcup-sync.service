# World Cup results sync — apply final match scores.
# Fired every 30 min by worldcup-sync.timer.
# Install: sudo cp /home/deploy/fantasy-platform/deploy/worldcup-*.service /etc/systemd/system/
#          sudo cp /home/deploy/fantasy-platform/deploy/worldcup-*.timer   /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now worldcup-sync.timer worldcup-advancement.timer worldcup-digest.timer

[Unit]
Description=World Cup results sync (apply finals)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
# Bound the run well under the 30-min timer so a stuck sync can't pile up.
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask worldcup sync --mode scores
