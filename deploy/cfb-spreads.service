# CFB Survivor spread update — OPEN the next week with its lines, or
# gap-fill the open week (ADR-062). Fired Tue + Fri by cfb-spreads.timer.
# Works on the lowest week that has games and has not locked. Spreads lock
# at FIRST successful fetch (Tuesday, by design — DQ-6); the first line
# that lands flips is_active to this week and sends the picks-open letter
# in the same run. The Friday run fills gaps only and makes no odds call
# when every line is already locked. Manual admin entries are locked on
# entry and never overwritten. A failed run emails the admin; the scores
# run (Sun–Thu 08:00 CT) retries the open.

[Unit]
Description=CFB Survivor spread update (open the week, lock spreads)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask cfb sync --mode spreads
