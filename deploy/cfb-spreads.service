# CFB Survivor spread update — lock spreads for the active week's games.
# Fired Tue + Fri by cfb-spreads.timer. Spreads lock at FIRST successful
# fetch (Tuesday, by design — DQ-6); the Friday run fills gaps only.
# Manual admin entries are locked on entry and never overwritten.

[Unit]
Description=CFB Survivor spread update (lock spreads)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/fantasy-platform
EnvironmentFile=/home/deploy/fantasy-platform/.env
Environment=ENVIRONMENT=production
Environment=FLASK_APP=app.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=5m
ExecStart=/home/deploy/fantasy-platform/venv/bin/flask cfb sync --mode spreads
