<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reset Your Password</title>
<!--[if mso]><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #f5f3f0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; -webkit-font-smoothing: antialiased;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f5f3f0;">
<tr><td align="center" style="padding: 24px 16px;">

<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; background-color: #ffffff;">

<!-- HEADER -->
<tr><td style="background-color: #4a2d7a; padding: 22px 32px; text-align: center;">
<span style="font-family: Georgia, 'Times New Roman', serif; font-size: 22px; font-weight: 700; color: #f7f8f9; letter-spacing: 0.01em;">&#127942; The Commissioner&#8217;s Club</span>
</td></tr>

<!-- GOLD ACCENT BAR -->
<tr><td style="background-color: #c9a84c; height: 3px; font-size: 0; line-height: 0;">&nbsp;</td></tr>

<!-- CONTENT -->
<tr><td style="padding: 36px 32px 28px 32px;">

<h1 style="margin: 0 0 8px 0; font-family: Georgia, 'Times New Roman', serif; font-size: 24px; font-weight: 700; color: #1a1f25;">Reset Your Password</h1>

<p style="margin: 0 0 24px 0; font-size: 15px; line-height: 1.6; color: #4a5568;">
Hi {{ user.get_display_name() }}, you requested a password reset for your account. Click the button below to choose a new password.
</p>

<!-- CTA BUTTON -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td align="center" style="padding: 8px 0 24px 0;">
<a href="{{ reset_url }}" style="display: inline-block; background-color: #c9a84c; color: #1a1f25; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 16px; font-weight: 700; text-decoration: none; padding: 14px 36px; border-radius: 6px;">Reset My Password &rarr;</a>
</td></tr>
</table>

<p style="margin: 0 0 16px 0; font-size: 13px; line-height: 1.5; color: #8b95a2;">
This link expires in <strong>1 hour</strong>. If you didn&#8217;t request a reset, you can safely ignore this email &mdash; your password will not be changed.
</p>

<!-- PLAIN URL FALLBACK -->
<p style="margin: 0; font-size: 12px; line-height: 1.5; color: #8b95a2; word-break: break-all;">
If the button doesn&#8217;t work, copy and paste this URL into your browser:<br>
<a href="{{ reset_url }}" style="color: #6C3FA0; text-decoration: underline;">{{ reset_url }}</a>
</p>

</td></tr>

<!-- FOOTER -->
<tr><td style="background-color: #2d1a4e; padding: 20px 32px; text-align: center;">
<p style="margin: 0; font-size: 13px; color: rgba(247,248,249,0.6); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;">
The Commissioner&#8217;s Club &middot; Fantasy Sports Platform
</p>
</td></tr>

</table>

</td></tr>
</table>
</body>
</html>
