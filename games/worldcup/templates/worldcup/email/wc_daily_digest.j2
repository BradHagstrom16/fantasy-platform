<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Your World Cup results &mdash; {{ date_str }}</title>
</head>
<body style="margin:0; padding:0; background:#F3EFE6; font-family:'Newsreader', Georgia, 'Times New Roman', serif; color:#1C1730; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background:#F3EFE6; min-width:320px;">
  <tr>
    <td align="center" style="padding:28px 16px 32px;">

      <!-- Card shell -->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
             style="max-width:560px; background:#FFFFFF; border-radius:8px; overflow:hidden;
                    box-shadow:0 4px 20px rgba(58,29,114,.12);">

        <!-- ══ HEADER BAND ══ -->
        <tr>
          <td style="background:#2A1150; padding:26px 32px 20px; text-align:center;">
            <!--[if !mso]><!-->
            <img src="{{ logo_url }}?v={{ asset_version }}"
                 width="140" height="140"
                 alt="Corrupt Commish Club"
                 style="display:block; margin:0 auto; border:0; max-width:140px;">
            <!--<![endif]-->
            <!--[if mso]>
            <div style="font-family:Arial,sans-serif; font-size:22px; font-weight:bold;
                        letter-spacing:.06em; color:#C9A227; text-transform:uppercase;">
              CORRUPT COMMISH CLUB
            </div>
            <![endif]-->
            <div style="font-family:'Teko', Arial, sans-serif; font-size:12px; font-weight:500;
                        letter-spacing:.14em; color:rgba(243,239,230,.85); text-transform:uppercase;
                        margin-top:4px;">
              World Cup Fantasy Pool
            </div>
          </td>
        </tr>

        <!-- ══ SCORE HERO ══ -->
        <tr>
          <td style="background:#F3EFE6; padding:22px 28px 16px;">
            <div style="font-family:'Newsreader', Georgia, serif; font-size:14px;
                        color:#5A5470; margin-bottom:10px; line-height:1.4;">
              Good morning, {{ enrollment.get_display_name() }}
            </div>

            <!-- Total score -->
            <div style="font-family:'Teko', Arial, sans-serif; font-size:42px; font-weight:600;
                        color:#3A1D72; line-height:1; letter-spacing:.02em;">
              {{ enrollment.total_score | round | int }} <span style="font-size:21px; font-weight:500; letter-spacing:.04em; opacity:.65;">pts</span>
            </div>

            <!-- Delta — navy, positive signal -->
            <div style="font-family:'Teko', Arial, sans-serif; font-size:16px; font-weight:600;
                        color:#002868; letter-spacing:.04em; margin-top:6px;">
              &#9650;&nbsp;+{{ total_yesterday_str }} pts on {{ date_str }}
            </div>

            <!-- Rank + change signal -->
            <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                   style="margin-top:5px;">
              <tr>
                <td style="font-family:'Newsreader', Georgia, serif; font-size:13px;
                            color:#5A5470; vertical-align:middle;">
                  Rank&nbsp;<strong style="color:#3A1D72;">#{{ rank }}</strong>&nbsp;of&nbsp;{{ total_enrolled }}
                </td>
                {% if rank_delta is not none %}
                <td style="padding-left:8px; vertical-align:middle;">
                  {% if rank_delta > 0 %}
                  <span style="display:inline-block; padding:2px 8px; border-radius:3px;
                               background:rgba(26,122,69,.1); font-family:'Teko',Arial,sans-serif;
                               font-size:12px; font-weight:600; letter-spacing:.04em;
                               color:#1A7A45; white-space:nowrap;">
                    &#8593;&nbsp;{{ rank_delta }}&nbsp;spot{{ 's' if rank_delta != 1 else '' }}
                  </span>
                  {% elif rank_delta < 0 %}
                  <span style="display:inline-block; padding:2px 8px; border-radius:3px;
                               background:rgba(192,57,43,.08); font-family:'Teko',Arial,sans-serif;
                               font-size:12px; font-weight:600; letter-spacing:.04em;
                               color:#C0392B; white-space:nowrap;">
                    &#8595;&nbsp;{{ rank_delta | abs }}&nbsp;spot{{ 's' if rank_delta | abs != 1 else '' }}
                  </span>
                  {% else %}
                  <span style="display:inline-block; padding:2px 8px; border-radius:3px;
                               background:rgba(90,84,112,.08); font-family:'Teko',Arial,sans-serif;
                               font-size:12px; font-weight:600; letter-spacing:.04em;
                               color:#5A5470; white-space:nowrap;">
                    &#8594;&nbsp;Steady
                  </span>
                  {% endif %}
                </td>
                {% endif %}
              </tr>
            </table>
          </td>
        </tr>

        <!-- ══ NAVY RULE ══ -->
        <tr>
          <td style="padding:0 28px;">
            <div style="height:2px; background:#002868; border-radius:1px;"></div>
          </td>
        </tr>

        <!-- ══ PICKS SECTION ══ -->
        <tr>
          <td style="background:#FFFFFF; padding:18px 28px 0;">
            <div style="font-family:'Teko', Arial, sans-serif; font-size:11px; font-weight:500;
                        letter-spacing:.1em; text-transform:uppercase; color:#8A849B;
                        margin-bottom:12px;">
              Your picks that scored
            </div>

            {% for r in match_results %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                   style="margin-bottom:{{ '12px' if not loop.last else '0' }};
                          padding-bottom:{{ '12px' if not loop.last else '0' }};
                          border-bottom:{{ '1px solid #F0ECE4' if not loop.last else 'none' }};">
              <tr>
                <!-- Flag -->
                <td width="28" valign="middle" style="padding-right:10px;">
                  <img src="{{ site_url }}/static/flags/{{ r.team.iso_code or '_tbd' }}.svg?v={{ asset_version }}"
                       width="24" height="18" alt="{{ r.team.fifa_code }}"
                       style="display:block; border-radius:2px; border:1px solid rgba(0,0,0,.06);">
                </td>

                <!-- Team name + match info -->
                <td valign="middle">
                  <div style="font-family:'Teko', Arial, sans-serif; font-size:17px; font-weight:600;
                              color:#1C1730; letter-spacing:.02em; line-height:1.15;">
                    {{ r.team.display_name }}&nbsp;<span style="font-size:12px; font-weight:500;
                        color:#8A849B; letter-spacing:.04em;">{{ r.multiplier_str }}</span>
                  </div>
                  <div style="font-family:'Newsreader', Georgia, serif; font-size:12px;
                              color:#5A5470; margin-top:2px; line-height:1.3;">
                    {{ r.match_score }}&nbsp;&middot;&nbsp;<span style="font-weight:600;
                      color:{% if r.result == 'won' %}#1A7A45{% elif r.result == 'draw' %}#C9A227{% else %}#8A849B{% endif %};">{{ r.result | title }}</span>&nbsp;&middot;&nbsp;<span style="color:#8A849B;">{{ r.stage_label }}</span>
                  </div>
                </td>

                <!-- Points — navy -->
                <td align="right" valign="middle" style="padding-left:12px; white-space:nowrap;">
                  <span style="font-family:'Teko', Arial, sans-serif; font-size:19px; font-weight:600;
                               color:#002868; letter-spacing:.02em;">
                    +{{ r.points_str }}&nbsp;pts
                  </span>
                </td>
              </tr>
            </table>
            {% endfor %}
          </td>
        </tr>

        <!-- ══ CTA ══ -->
        <tr>
          <td style="background:#FFFFFF; padding:16px 28px 28px; text-align:center;">
            <div style="height:1px; background:#F0ECE4; margin-bottom:20px;"></div>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                   style="margin:0 auto;">
              <tr>
                <td align="center"
                    style="background:linear-gradient(135deg,#F2D36B 0%,#C9A227 45%,#8A6A1A 100%);
                           border-radius:6px;">
                  <a href="{{ site_url }}/worldcup/leaderboard"
                     style="display:inline-block; padding:12px 28px;
                            font-family:'Teko', Arial, sans-serif; font-size:15px; font-weight:600;
                            letter-spacing:.08em; text-transform:uppercase;
                            color:#1C0A3A; text-decoration:none;">
                    View Standings &#8594;
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- ══ FOOTER BAND ══ -->
        <tr>
          <td style="background:#1C0A3A; padding:14px 28px; text-align:center;">
            <span style="font-family:'Teko', Arial, sans-serif; font-size:11px;
                         letter-spacing:.12em; color:rgba(243,239,230,.4); text-transform:uppercase;">
              Corrupt Commish Club &nbsp;&middot;&nbsp; cccfantasy.com
            </span>
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>
