# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment (no trailing slash — also matches `venv`/`.venv`
# symlinks devs create in worktrees pointing at the main checkout's venv)
venv
.venv

# Database (no trailing slash — also matches the `instance` symlink devs
# create in worktrees pointing at the main checkout's instance/)
instance
*.db

# Environment
.env
env_config.sh
email_config.py

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Claude local overrides only — project config in .claude/ is committed
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Claude Code's native worktrees (EnterWorktree) live here; never repo content
.claude/worktrees/
# impeccable is ONE user-level install (~/.agents/skills, symlinked into ~/.claude).
# `npx impeccable update` is scope-aware since the v4 CLI and never creates a copy, but
# a bare `npx impeccable install` in a repo can; add-game is the only tracked project skill.
.claude/skills/impeccable/

# DO NOT ignore migrations/ — these must be committed

# PII guards: neither directory exists today (both removed 2026-09-18), but if a
# legacy-DB staging copy or a prod dump is ever dropped here again it carries
# member emails + password hashes and must never be staged.
_migration_source/
_dbdump/

# Git worktrees
.worktrees/

# Playwright MCP session snapshots (ephemeral)
.playwright-mcp/

# Superpowers brainstorm session state (ephemeral)
.superpowers/

# Pytest cache
.pytest_cache/

# Local design / verification artifacts (screenshots, reference dumps)
verify-*/
verify-*.png
post-state-*.png
audit-*.png
fantasy-platform-and-world-cup-design/
.remember/

# Impeccable: the shared config (detector exceptions, hook settings), the design sidecar
# and the surface briefs are committed; per-session output and per-machine state are not
# (config.local.json holds this machine's hook consent).
.impeccable-review/
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/critique/
.impeccable/review/
.impeccable/live/

# Designer logo delivery — the masters, kept on file (integrated May 2026; brand-kit variants unwired)
CCC-final/

# Brad's weekly write-ups (personal drafts, never repo content)
docs/WeeklyWriteUps/

# Codex CLI artifacts — tried once, never adopted; block RETIRED and deleted 2026-08-12
# (AGENTS.md had drifted 6 weeks stale and knew nothing of games/docket/). Rules kept as a
# guard so a future codex/`npx skills add` run can't commit a stray copy. CLAUDE.md is the
# single agent-instruction SSoT; do not reintroduce a parallel AGENTS.md mirror.
.agents/
.codex/
AGENTS.md

# Ruff linter cache
.ruff_cache/
.gstack/
