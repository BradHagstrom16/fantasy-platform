# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment (no trailing slash — also matches `venv`/`.venv`
# symlinks devs create in worktrees pointing at the main checkout's venv)
venv
.venv

# Database (no trailing slash — also matches the `instance` symlink devs
# create in worktrees pointing at the main checkout's instance/)
instance
*.db

# Environment
.env
env_config.sh
email_config.py

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Claude local overrides only — project config in .claude/ is committed
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Claude Code's native worktrees (EnterWorktree) live here; never repo content
.claude/worktrees/
# impeccable is a GLOBAL skill (~/.agents/skills, symlinked into ~/.claude);
# `npx impeccable skills update` run from a repo root drops a stray copy here.
# add-game is the only intended tracked project skill.
.claude/skills/impeccable/

# DO NOT ignore migrations/ — these must be committed

_migration_source/

# Git worktrees
.worktrees/

# Playwright MCP session snapshots (ephemeral)
.playwright-mcp/

# Superpowers brainstorm session state (ephemeral)
.superpowers/

# Pytest cache
.pytest_cache/

# Local design / verification artifacts (screenshots, reference dumps)
verify-*/
verify-*.png
post-state-*.png
audit-*.png
fantasy-platform-and-world-cup-design/
.remember/

# Impeccable design-review screenshots and rendered HTML (regenerated per session)
.impeccable-review/
.impeccable/

# Designer logo delivery — under review, not yet integrated
CCC-final/
_dbdump/

# Codex CLI artifacts — tried once, never adopted; block RETIRED and deleted 2026-08-12
# (AGENTS.md had drifted 6 weeks stale and knew nothing of games/docket/). Rules kept as a
# guard so a future codex/`npx skills add` run can't commit a stray copy. CLAUDE.md is the
# single agent-instruction SSoT; do not reintroduce a parallel AGENTS.md mirror.
.agents/
.codex/
AGENTS.md

# Ruff linter cache
.ruff_cache/
.gstack/
